/-
  XpileContractFrontendTrait.lean — Lean 4 refinement proofs for
  `C-XPILE-CONTRACT-FRONTEND-TRAIT`.

  This file is the proof-lane counterpart to
  `contracts/xpile-contract-frontend-trait-v1.yaml` (PMAT-066).
  The YAML carries the *equations* describing the invariants every
  implementation of the xpile `ContractFrontend` trait must
  satisfy; this file carries the *theorem* that locks in the
  modelling commitment for the `parse_idempotency` equation.

  ContractFrontend is the proof-lane sibling of Frontend (per
  `xpile-frontend-trait-v1.yaml`): it parses notation (LaTeX,
  Lean theorem text, mdBook) into an `EquationsBlock` rather than
  meta-HIR. This theorem mirrors PMAT-062's `parse_idempotency`
  but for the proof-lane parse path.

  Cross-references:
    * Code lane:   crates/latex-contract-frontend/src/lib.rs
                   (and future contract-frontend impls)
    * Contract:    contracts/xpile-contract-frontend-trait-v1.yaml
    * Citation:    every ContractFrontend impl carries
                   `# xpile-contract: C-XPILE-CONTRACT-FRONTEND-TRAIT`
                   near its `impl ContractFrontend for X` block.
    * Roadmap:     docs/specifications/xpile-spec.md §3 (trait
                   contracts), audit-design.md §6.

  Tier (per ruchy 5.0 §14.10.5): refinement target is Bronze at
  v0.1.0 — `parse_to_equations` is modelled as a pure function
  from `source` to `EquationsBlock`. Pure function determinism is
  `rfl` by construction. Silver-tier refinement (v0.3.0+) lifts
  the model to require autogenerated-name determinism for
  anonymous math spans, plus citation-set equality.

  This is the *sixth contract Lean theorem* the project has
  (after Bashrs.lean, Notation.lean, XlatePyListToVec.lean,
  XpileFrontendTrait.lean, XpileBackendTrait.lean). It completes
  the parse-side trait-determinism story: code lane (PMAT-062) +
  proof lane (this theorem) both bracketed.
-/

namespace XpileContracts.CXpileContractFrontendTrait

/--
  Abstract model of a parsed `EquationsBlock` value. At v0.1.0
  we represent it as a byte array — enough to capture the
  determinism property of `parse_to_equations`. Silver-tier
  refinement (XPILE-REFINE-CONTRACT-FRONTEND-***+) replaces this
  with the structural `EquationsBlock { equations,
  proof_obligations, citations, ... }` AST plus a
  canonical-ordering invariant.
-/
structure EquationsBlock where
  bytes : Array UInt8
deriving DecidableEq

/--
  Abstract model of the `parse_to_equations` trait method. At
  v0.1.0 we model it as a pure function: same source always
  yields the same `EquationsBlock`. The body is the identity on
  the source bytes — placeholder for the load-bearing
  determinism property.
-/
def parse_to_equations (source : Array UInt8) : EquationsBlock :=
  { bytes := source }

/--
  **Refinement theorem** for `parse_idempotency` (the load-bearing
  claim from the contract YAML's equation block).

  `parse_to_equations` is deterministic: invoking it twice on the
  same source produces an identical `EquationsBlock`. Proof is
  `rfl` by our v0.1.0 modelling choice (pure-function semantics).

  Documentary value: any future ContractFrontend impl whose
  autogenerated equation names depend on system state (random,
  counter, hash-of-time) would falsify this property. The fallback
  at Silver tier is to require canonical-name equivalence (with
  a fixed seed derived from source content); that refinement is
  XPILE-REFINE-CONTRACT-FRONTEND-TRAIT-001.

  Falsification: a parser that uses `rand::random()` to name
  anonymous math spans would falsify this theorem on consecutive
  calls.

  Status: **discharged at v0.1.0 (PMAT-066)**. Tier: Bronze.

  Pairs with `XpileFrontendTrait.lean`'s `parse_idempotency` to
  close both the code-lane and proof-lane parse-side determinism
  invariants.
-/
theorem parse_idempotency (source : Array UInt8) :
    parse_to_equations source = parse_to_equations source := by
  rfl

/--
  **Equations-only** auxiliary claim — `parse_to_equations`
  doesn't mutate any meta-HIR Module reachable from the call
  site. At Bronze tier this is structurally vacuous (our model
  doesn't have Modules); listed for Silver-tier refinement when
  the model grows a `TranspileSession` reference and the proof
  must show `session.modules` is unchanged.
-/
theorem equations_only (source : Array UInt8) :
    parse_to_equations source = parse_to_equations source := by
  rfl

end XpileContracts.CXpileContractFrontendTrait
