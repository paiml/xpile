    -- (a) canonical modules are empty
    (empty_session.modules = #[])
    -- (b) canonical equations are empty
    ∧ (empty_session.equations = #[])
    -- (c) canonical modules size is 0
    ∧ (empty_session.modules.size = 0)
    -- (d) canonical equations size is 0
